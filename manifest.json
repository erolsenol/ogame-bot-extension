{
  "name": "OGame helper experiment",
  "version": "0.1.0",
  "manifest_version": 3,
  "permissions": [],
  "action": {
    "default_popup": "index.html"
  },
  "minimum_chrome_version": "92",
  "background": {
    "service_worker": "background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.ogame.gameforge.com/game/*"
      ],
      "all_frames": false,
      "js": [
        "src/content.js"
      ],
      "run_at": "document_end"
    }
  ]
}
